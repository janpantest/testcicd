{
  "name": "pw",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf allure-results",
    "runBrowser": "npx playwright test --project=chromium --headed",
    "singleRun": "npx playwright test --project=chromium --headed  --workers=1",
    "search": "npx playwright test --project=chromium --headed  --workers=1 --grep @searchBook",
    "detail": "npx playwright test --project=chromium --headed  --workers=1 --grep @getDetail",
    "pagination": "npx playwright test --project=chromium --headed  --workers=1 --grep @pagination",
    "shopping": "npm run clean && npx playwright test --project=chromium --headed  --workers=1 --grep @sauce",
    "runReport": "npx playwright show-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.8.6",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.4.1",
    "dotenv": "^16.6.1",
    "playwright": "^1.55.0",
    "rimraf": "^6.0.1"
  }
}
